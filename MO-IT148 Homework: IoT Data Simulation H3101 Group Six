    "import pandas as pd\n",
    "import numpy as np\n",
    "from datetime import datetime, timedelta\n",
    "import uuid\n",
    "from pathlib import Path\n",
    "\n",
    "num_records = 100  # Adjust this number as needed\n",
    "\n",
    "# 1. Generate Data for Smart Logistics Tracking\n",
    "data = []\n",
    "\n",
    "for _ in range(num_records):\n",
    "    record = {\n",
    "        # Random timestamp in the last 24 hours\n",
    "        \"timestamp\": datetime.now() - timedelta(minutes=np.random.randint(0, 1440)),  \n",
    "        \n",
    "        # Simulating RFID Tag for package identity/counterfeit prevention\n",
    "        \"rfid_tag\": f\"RFID-{uuid.uuid4().hex[:10].upper()}\",  \n",
    "        \n",
    "        # Simulating GPS Sensor - Latitude (-90 to 90) and Longitude (-180 to 180)\n",
    "        \"gps_latitude\": round(np.random.uniform(-90.0, 90.0), 6),  \n",
    "        \"gps_longitude\": round(np.random.uniform(-180.0, 180.0), 6), \n",
    "        \n",
    "        # Simulating Temperature Sensor for perishable goods (e.g., -5°C to 25°C)\n",
    "        \"temperature_c\": round(np.random.uniform(-5.0, 25.0), 1),  \n",
    "        \n",
    "        # Simulating a Blockchain transaction hash for supply chain transparency\n",
    "        \"blockchain_hash\": uuid.uuid4().hex  \n",
    "    }\n",
    "    data.append(record)\n",
    "\n",
    "# Convert to DataFrame\n",
    "df = pd.DataFrame(data)\n",
    "\n",
    "# 2. Find the path to your system's Downloads folder\n",
    "downloads_path = Path.home() / \"Downloads\"\n",
    "\n",
    "# Ensure the Downloads folder exists (prevents errors on some systems)\n",
    "downloads_path.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# 3. Save the dataset directly to the Downloads folder\n",
    "csv_file_path = downloads_path / \"logistics_tracking_data.csv\"\n",
    "json_file_path = downloads_path / \"logistics_tracking_data.json\"\n",
    "\n",
    "df.to_csv(csv_file_path, index=False)\n",
    "df.to_json(json_file_path, orient=\"records\", date_format=\"iso\")\n",
    "\n",
    "# 4. Display the results and confirm paths\n",
    "print(f\"Success! Files saved directly to:\")\n",
    "print(f\"CSV:  {csv_file_path}\")\n",
    "print(f\"JSON: {json_file_path}\\n\")\n",
    "\n",
    "print(\"Smart Logistics Tracking Data Sample:\")\n",
    "print(df.head())"
   ]
  }
